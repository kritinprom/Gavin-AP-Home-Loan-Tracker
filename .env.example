# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE_CHANNEL_ACCESS_TOKEN: LINE Messaging API Channel Access Token for sending real-time loan status alerts.
LINE_CHANNEL_ACCESS_TOKEN=

# LINE_CHANNEL_SECRET: LINE Messaging API Channel Secret for verifying webhook signatures.
LINE_CHANNEL_SECRET=

# LINE_OA_ID: Optional LINE Official Account ID (e.g., @gavinmortgage) shown to customers for linking.
LINE_OA_ID=

# ADMIN_PASSCODE: Passcode for GAVIN Officer / Admin Portal (leave empty to use first-run setup form).
ADMIN_PASSCODE=
